{
  "name": "triattendance-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Location-verified employee attendance monitoring portal and API",
  "scripts": {
    "dev": "pnpm --parallel --filter @triattendance/* dev",
    "build": "pnpm --filter @triattendance/* build",
    "test": "pnpm --filter @triattendance/* test",
    "lint": "pnpm --filter @triattendance/* lint",
    "typecheck": "pnpm --filter @triattendance/* typecheck",
    "clean": "pnpm --recursive exec rm -rf node_modules dist .next"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.11.2"
}
